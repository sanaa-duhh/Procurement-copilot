  "procurement_decision_schema": {
    "$defs": {
      "EvidenceItem": {
        "properties": {
          "source": {
            "description": "Tool/data source name",
            "title": "Source",
            "type": "string"
          },
          "finding": {
            "description": "Concise factual finding",
            "title": "Finding",
            "type": "string"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional record ID / policy section / endpoint",
            "title": "Reference"
          }
        },
        "required": [
          "source",
          "finding"
        ],
        "title": "EvidenceItem",
        "type": "object"
      },
      "RunTelemetry": {
        "properties": {
          "llm_calls": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Llm Calls"
          },
          "tool_calls": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tool Calls"
          },
          "tool_names": {
            "items": {
              "type": "string"
            },
            "title": "Tool Names",
            "type": "array"
          }
        },
        "title": "RunTelemetry",
        "type": "object"
      }
    },
    "properties": {
      "request_id": {
        "title": "Request Id",
        "type": "string"
      },
      "recommendation": {
        "description": "Short recommendation label or sentence",
        "title": "Recommendation",
        "type": "string"
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/EvidenceItem"
        },
        "title": "Evidence",
        "type": "array"
      },
      "required_approvals": {
        "items": {
          "type": "string"
        },
        "title": "Required Approvals",
        "type": "array"
      },
      "missing_information": {
        "items": {
          "type": "string"
        },
        "title": "Missing Information",
        "type": "array"
      },
      "risk_flags": {
        "items": {
          "type": "string"
        },
        "title": "Risk Flags",
        "type": "array"
      },
      "next_step": {
        "title": "Next Step",
        "type": "string"
      },
      "human_review_required": {
        "default": true,
        "title": "Human Review Required",
        "type": "boolean"
      },
      "telemetry": {
        "anyOf": [
          {
            "$ref": "#/$defs/RunTelemetry"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "request_id",
      "recommendation",
      "next_step"
    ],
    "title": "ProcurementDecision",
    "type": "object"
  }
}
