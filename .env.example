# Local mock vendor-risk service (started by run_local.py)
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Model provider: "anthropic" (default) or "mock" (offline scripted stand-in, for trying the UI / tests only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL_NAME=claude-opus-5
# Reasoning effort passed to the model: low | medium | high
LLM_EFFORT=medium
